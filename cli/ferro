def cmd_list_apps(args):
    reg = registry()
    print(_c("1", "Known apps (registry):"))
    for name, ent in reg.items():
        print(f"  {name:12s} {ent.get('git','')}  ({ent.get('desc','')})")
    forge = find_forge(getattr(args, "forge", None))
    if forge and os.path.isdir(apps_dir(forge)):
        installed = sorted(d for d in os.listdir(apps_dir(forge)) if os.path.isdir(os.path.join(apps_dir(forge), d)))
        print(_c("1", f"\nIn forge {forge}:"))
        for a in installed:
            print(f"  {a}")

def cmd_bootstrap(args):
    """One-shot quick start (delegates to scripts/bootstrap.sh)."""
    script = os.path.join(HOME, "scripts", "bootstrap.sh")
    argv = ["bash", script]
    if args.forge_name:
        argv += ["--forge", args.forge_name]
    if args.apps:
        argv += ["--apps", args.apps]
    if args.no_setup:
        argv += ["--no-setup"]
    os.execv("/bin/bash", argv)

# ================================================================== arg parsing

def build_parser():
    p = argparse.ArgumentParser(prog="ferro", description="The Ferro runtime CLI (a bench for ferro).")
    p.add_argument("--forge", help="forge dir (default: discovered from cwd / $FERRO_FORGE)")
    sub = p.add_subparsers(dest="cmd")

    def add_site(sp):
        sp.add_argument("--site", help="site name (default: forge default_site)")

    sp = sub.add_parser("setup", help="install toolchain dependencies")
    sp.add_argument("--yes", action="store_true", help="non-interactive")
    sp.set_defaults(fn=cmd_setup)

    sp = sub.add_parser("bootstrap", help="one-shot: setup+build+site+apps+serve-ready")
    sp.add_argument("--forge", dest="forge_name", default="forge", help="forge dir to create (default: ./forge)")
    sp.add_argument("--apps", help="comma apps (default: crm,helpdesk,gameplan,hrms,erpnext)")
    sp.add_argument("--no-setup", action="store_true", help="skip dependency install")
    sp.set_defaults(fn=cmd_bootstrap)

    sp = sub.add_parser("doctor", help="check toolchain + binaries")
    sp.set_defaults(fn=cmd_doctor)

    sp = sub.add_parser("build", help="compile a runtime binary (ferrod default)")
    sp.add_argument("runtime", nargs="?", default="ferrod", help="ferrod | ferro/rust | native | all")
    sp.add_argument("--transpile", action="store_true", help="(native) re-transpile controllers first")
    sp.set_defaults(fn=cmd_build)

    sp = sub.add_parser("init", help="create a new forge (workspace)")
    sp.add_argument("name", help="forge directory")
    sp.add_argument("--port", type=int, default=8000, help="default webserver port")
    sp.set_defaults(fn=cmd_init)

    sp = sub.add_parser("new-site", help="create a site from the frappe-core seed")
    sp.add_argument("name", help="site name, e.g. dev.localhost")
    sp.set_defaults(fn=cmd_new_site)

    sp = sub.add_parser("get-app", help="fetch an app repo into the forge")
    sp.add_argument("app")
    sp.add_argument("--git", help="git URL override")
    sp.add_argument("--branch", help="branch")
    sp.add_argument("--mirror", help="copy from a local mirror dir instead of cloning")
    sp.set_defaults(fn=cmd_get_app)

    sp = sub.add_parser("install-app", help="materialise an app's schema into a site")
    add_site(sp); sp.add_argument("app")
    sp.set_defaults(fn=cmd_install_app)

    sp = sub.add_parser("populate", help="fill read-path doctypes with demo rows")
    add_site(sp); sp.add_argument("--rows", type=int, default=3000)
    sp.set_defaults(fn=cmd_populate)

    def add_runtime(sp):
        sp.add_argument("--runtime", help="ferrod | ferro/rust | native (default: forge runtime)")
        sp.add_argument("--apps", help="(ferrod) comma apps to load")
        sp.add_argument("--load", default="lazy", help="(ferrod) all | lazy | none")

    sp = sub.add_parser("serve", help="serve the REST API")
    add_site(sp); add_runtime(sp)
    sp.add_argument("--port", type=int); sp.add_argument("--threads", type=int)
    sp.add_argument("--user", default="Administrator", help="default user (bypasses token auth)")
    sp.add_argument("--dev", action="store_true", help="expose raw error text")
    sp.set_defaults(fn=cmd_serve)

    sp = sub.add_parser("request", help="one in-process request (no server)")
    add_site(sp); add_runtime(sp)
    sp.add_argument("method"); sp.add_argument("url"); sp.add_argument("body", nargs="?")
    sp.add_argument("--user", default="Administrator"); sp.add_argument("--dev", action="store_true")
    sp.set_defaults(fn=cmd_request)

    sp = sub.add_parser("measure", help="post-boot memory (RSS/PSS/USS)")
    add_site(sp); add_runtime(sp)
    sp.set_defaults(fn=cmd_measure)

    sp = sub.add_parser("loadtest", help="peak memory + throughput under load")
    add_site(sp); add_runtime(sp)
    sp.add_argument("--threads", type=int, default=4); sp.add_argument("--rounds", type=int, default=8)
    sp.set_defaults(fn=cmd_loadtest)

    sp = sub.add_parser("bench", help="alias for loadtest", aliases=["matrix"])
    add_site(sp); add_runtime(sp)
    sp.add_argument("--threads", type=int, default=4); sp.add_argument("--rounds", type=int, default=8)
    sp.set_defaults(fn=cmd_loadtest)

    sp = sub.add_parser("dev", help="run an app's frontend dev server (vite) -> ferro")
    sp.add_argument("app"); sp.add_argument("--port", type=int, help="backend port to proxy to")
    sp.set_defaults(fn=cmd_dev)

    sp = sub.add_parser("frontend", help="zero-node static+proxy gateway for a built frontend")
    sp.add_argument("app", nargs="?")
    sp.add_argument("--static", help="static dir to serve (default: app's dist/public)")
    sp.add_argument("--port", type=int, default=8080, help="gateway port")
    sp.add_argument("--backend-port", type=int, default=8000, help="ferro backend port")
    sp.set_defaults(fn=cmd_frontend)

    sp = sub.add_parser("start", help="run all Procfile processes")
    sp.set_defaults(fn=cmd_start)

    sp = sub.add_parser("verify", help="functional proof the apps run (needs ferrod + apps)")
    add_site(sp); sp.add_argument("--apps", help="comma apps (default: all 5)")
    sp.set_defaults(fn=cmd_verify)

    sp = sub.add_parser("provision-key", help="provision api_key:secret for a user")
    add_site(sp); sp.add_argument("user", nargs="?", default="Administrator")
    sp.set_defaults(fn=cmd_provision_key)

    sp = sub.add_parser("list-apps", help="show app registry + installed apps", aliases=["apps"])
    sp.set_defaults(fn=cmd_list_apps)

    sp = sub.add_parser("version", help="show versions"); sp.set_defaults(fn=cmd_version)
    sp = sub.add_parser("doctor-json", help=argparse.SUPPRESS); sp.set_defaults(fn=cmd_doctor)
    return p

def main():
    parser = build_parser()
    args = parser.parse_args()
    if not getattr(args, "cmd", None):
        parser.print_help()
        sys.exit(0)
    args.fn(args)

if __name__ == "__main__":
    main()
